# Charlie MJ Music - optional live integrations.
PORT=3000
# YouTube Data API v3 key. Leave blank to keep provider disabled.
YOUTUBE_API_KEY=
# Spotify client credentials. Search requires a valid Spotify application.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# AudD music recognition API token. Leave blank to disable recognition.
AUDD_API_TOKEN=
# Local Ollama endpoint/model. Ollama is optional.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
